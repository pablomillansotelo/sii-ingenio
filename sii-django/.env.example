# Copia a .env y ajusta. Nunca subas secretos al repo.

# Configuración General
DEBUG=True
SECRET_KEY=django-insecure-cambiar-esto-en-produccion
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de Datos de Negocio (sii_db)
DB_NAME=sii_db
DB_USER=postgres
DB_PASSWORD=tu_password_local
DB_HOST=localhost
DB_PORT=5432

# Base de Datos de Autenticación (sii_auth_db)
AUTH_NAME=sii_auth_db
AUTH_USER=postgres
AUTH_PASSWORD=tu_password_local
AUTH_HOST=localhost
AUTH_PORT=5432

# Neon Object Storage (S3-compatible)
# En local puedes dejarlo vacío: DEBUG usa MEDIA_ROOT.
# En Vercel pega las keys desde Neon Console → Object Storage / credentials.
# Proyecto ingenio, branch production, bucket privado `aula`.
NEON_S3_ENDPOINT=https://br-steep-firefly-aeejx5g3.storage.c-2.us-east-2.aws.neon.tech
NEON_S3_REGION=us-east-2
NEON_S3_ACCESS_KEY_ID=
NEON_S3_SECRET_ACCESS_KEY=
NEON_S3_BUCKET=aula
